# Copia este archivo a .env. Nunca subas credenciales al repositorio.
# Gmail: completa usuario, contraseña de aplicación y remitente.
# Si alguno falta, solo se guardan vistas previas, sin envío.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TEST_TO=
# SMTP_USER y SMTP_FROM: tu dirección Gmail completa.
# SMTP_PASSWORD: contraseña de aplicación, no la contraseña normal de Google.
# SMTP_TEST_TO: una dirección que controles, para el envío de prueba explícito.
# SMTP_SECURITY=ssl para puerto 465. Usa contraseña de aplicación del proveedor.
# El correo SMTP_FROM debe estar autorizado por ese proveedor.

GATEWAY_PORT=8080
# Genera tu propia clave de 32 caracteres o más para Docker Compose.
# start.py la genera automáticamente si se deja vacía.
INTERNAL_API_KEY=
COOKIE_SECURE=0
# En un despliegue HTTPS: COOKIE_SECURE=1 y PUBLIC_ORIGIN=https://tu-dominio
